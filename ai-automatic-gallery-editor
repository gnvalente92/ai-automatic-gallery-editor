#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "This bootstrap launcher currently supports macOS only." >&2
  exit 1
fi

# Install tools into the user's normal locations; Homebrew is not a prerequisite.
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

install_from_official_script() {
  local name="$1"
  local url="$2"
  echo "${name} is missing. Installing it from its official installer..."
  if ! command -v curl >/dev/null 2>&1; then
    echo "curl is required to install ${name}; install Apple's Command Line Tools and retry." >&2
    exit 1
  fi
  curl -fsSL "$url" | /bin/sh
}

if ! command -v uv >/dev/null 2>&1; then
  install_from_official_script "uv" "https://astral.sh/uv/install.sh"
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
fi

OLLAMA_ENDPOINT="${LOCAL_MODEL_ENDPOINT:-http://127.0.0.1:11434/v1}"
case "$OLLAMA_ENDPOINT" in
  http://127.0.0.1:11434*|http://localhost:11434*)
    if ! command -v ollama >/dev/null 2>&1; then
      install_from_official_script "Ollama" "https://ollama.com/install.sh"
      export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH"
    fi
    ;;
  *)
    echo "Using configured local model endpoint; Ollama installation is not needed."
    ;;
esac

if ! command -v uv >/dev/null 2>&1; then
  echo "uv installation finished but its executable is not on PATH. Restart Terminal and retry." >&2
  exit 1
fi
case "$OLLAMA_ENDPOINT" in
  http://127.0.0.1:11434*|http://localhost:11434*)
    if ! command -v ollama >/dev/null 2>&1; then
      echo "Ollama installation finished but its executable is not on PATH. Restart Terminal and retry." >&2
      exit 1
    fi
    ;;
esac

echo "Preparing Python 3.12, RAW/JPEG dependencies and the local gallery editor..."
exec uv run --project "$SCRIPT_DIR" --extra raw --python 3.12 ai-automatic-gallery-editor "$@"
